[Unit]
Description=Dual MEMS USB voice microphone (noise-filtered)
After=sound.target g-audio-gadget.service
Requires=g-audio-gadget.service
Wants=sound.target

[Service]
Type=simple
User=methoonema
WorkingDirectory=/home/methoonema/mic
ExecStart=/home/methoonema/mic/.venv/bin/python /home/methoonema/mic/usb_voice_mic.py --input-device 0
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
